generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String?   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  username             String?
  timezone             String    @default("America/New_York")
  workHoursStart       String    @default("09:00")
  workHoursEnd         String    @default("18:00")
  afterHoursThreshold  String    @default("20:00")
  onboardingCompleted  Boolean   @default(false)
  plan                 String    @default("solo")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  profile              UserProfile?
  preferences          UserPreference?
  integrations         Integration[]
  repositories         Repository[]
  activityEvents       ActivityEvent[]
  commits              Commit[]
  pullRequests         PullRequest[]
  pullRequestReviews   PullRequestReview[]
  issues               Issue[]
  cicdRuns             CICDRun[]
  deployments          Deployment[]
  calendarEvents       CalendarEvent[]
  focusSessions        FocusSession[]
  devHealthSignals     DevHealthSignal[]
  aiConversations      AIConversation[]
  generatedSummaries   GeneratedSummary[]
  sharedReports        SharedReport[]
  dismissedInsights    DismissedInsight[]
  notifications        Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  company   String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique

  afterHoursSignal     Boolean @default(true)
  weekendSignal        Boolean @default(true)
  churnSignal          Boolean @default(true)
  meetingsSignal       Boolean @default(true)
  longWorkSignal       Boolean @default(true)
  interruptionSignal   Boolean @default(true)

  privacyActivity      String  @default("PRIVATE")
  privacyDevHealth     String  @default("PRIVATE")
  privacyFocus         String  @default("PRIVATE")
  privacyAiSummaries   String  @default("PRIVATE")
  privacyPerformance   String  @default("PRIVATE")
  privacyCalendar      String  @default("PRIVATE")
  privacyRepositories  String  @default("PRIVATE")

  aiEnabled            Boolean @default(true)
  notifyEmail          Boolean @default(true)
  notifySlack          Boolean @default(false)
  notifyInApp          Boolean @default(true)

  rankingWeights       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  status         String    @default("disconnected")
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  externalId     String?
  handle         String?
  lastSyncAt     DateTime?
  lastError      String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model Repository {
  id             String    @id @default(cuid())
  userId         String
  integrationId  String?
  provider       String
  externalId     String
  name           String
  fullName       String
  url            String?
  private        Boolean   @default(false)
  defaultBranch  String?
  selected       Boolean   @default(true)
  language       String?
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration  Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  events       ActivityEvent[]
  commits      Commit[]
  pullRequests PullRequest[]
  issues       Issue[]
  cicdRuns     CICDRun[]
  deployments  Deployment[]

  @@unique([userId, provider, externalId])
  @@index([userId])
  @@index([provider])
  @@index([fullName])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  type         String
  repository   String?
  repositoryId String?
  title        String
  description  String?
  url          String?
  timestamp    DateTime
  metadata     Json?
  externalId   String
  createdAt    DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository?  @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, type, externalId])
  @@index([userId, timestamp])
  @@index([userId, type])
  @@index([repositoryId])
  @@index([provider])
}

model Commit {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String?
  provider     String
  sha          String
  message      String
  url          String?
  authoredAt   DateTime
  additions    Int?
  deletions    Int?
  createdAt    DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, sha])
  @@index([userId, authoredAt])
  @@index([repositoryId])
}

model PullRequest {
  id            String    @id @default(cuid())
  userId        String
  repositoryId  String?
  provider      String
  externalId    String
  number        Int
  title         String
  state         String
  url           String?
  authorLogin   String?
  isAuthor      Boolean   @default(false)
  draft         Boolean   @default(false)
  merged        Boolean   @default(false)
  mergedAt      DateTime?
  openedAt      DateTime
  updatedAtSrc  DateTime?
  reviewState   String?
  additions     Int?
  deletions     Int?
  changedFiles  Int?
  labels        Json?
  createdAt     DateTime  @default(now())

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo    Repository?          @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  reviews PullRequestReview[]

  @@unique([userId, provider, externalId])
  @@index([userId, openedAt])
  @@index([userId, state])
  @@index([repositoryId])
}

model PullRequestReview {
  id            String   @id @default(cuid())
  userId        String
  pullRequestId String
  provider      String
  externalId    String
  state         String
  submittedAt   DateTime
  url           String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, submittedAt])
}

model Issue {
  id           String    @id @default(cuid())
  userId       String
  repositoryId String?
  provider     String
  externalId   String
  number       Int
  title        String
  state        String
  url          String?
  isAuthor     Boolean   @default(false)
  isAssigned   Boolean   @default(false)
  labels       Json?
  milestoneDue DateTime?
  openedAt     DateTime
  closedAt     DateTime?
  createdAt    DateTime  @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, openedAt])
  @@index([userId, state])
  @@index([repositoryId])
}

model CICDRun {
  id           String    @id @default(cuid())
  userId       String
  repositoryId String?
  provider     String
  externalId   String
  name         String
  status       String
  conclusion   String?
  branch       String?
  url          String?
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, startedAt])
  @@index([userId, conclusion])
  @@index([repositoryId])
}

model Deployment {
  id           String    @id @default(cuid())
  userId       String
  repositoryId String?
  provider     String
  externalId   String
  environment  String?
  status       String
  url          String?
  timestamp    DateTime
  createdAt    DateTime  @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, timestamp])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  provider    String    @default("google_calendar")
  externalId  String
  title       String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, startAt])
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  startedAt   DateTime
  endedAt     DateTime
  durationMin Int
  source      String   @default("derived")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model DevHealthSignal {
  id          String   @id @default(cuid())
  userId      String
  signalType  String
  headline    String
  detail      String
  value       String
  severity    String
  why         String
  recommendation String?
  periodStart DateTime
  periodEnd   DateTime
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, signalType])
}

model DismissedInsight {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, createdAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  sources        Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model GeneratedSummary {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  content     String
  sources     Json?
  periodStart DateTime?
  periodEnd   DateTime?
  status      String    @default("generated")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}

model SharedReport {
  id          String    @id @default(cuid())
  userId      String
  summaryId   String?
  token       String    @unique @default(cuid())
  visibility  String    @default("PRIVATE")
  revoked     Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
