generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GITHUB
  GITLAB
  BITBUCKET
  SLACK
  NOTION
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  DISCONNECTED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELED
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ReviewState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

enum IssueState {
  OPEN
  CLOSED
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
  SKIPPED
  UNKNOWN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FocusSessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
}

enum ActivityEventType {
  COMMIT
  PULL_REQUEST_OPENED
  PULL_REQUEST_UPDATED
  PULL_REQUEST_MERGED
  PULL_REQUEST_CLOSED
  REVIEW_REQUESTED
  REVIEW_COMPLETED
  ISSUE_OPENED
  ISSUE_CLOSED
  PIPELINE_STARTED
  PIPELINE_COMPLETED
  TASK_CREATED
  TASK_COMPLETED
  FOCUS_STARTED
  FOCUS_COMPLETED
  CALENDAR_EVENT
}

enum NotificationType {
  REVIEW_REQUESTED
  PIPELINE_FAILED
  PULL_REQUEST_STALE
  TASK_DUE
  SYNC_FAILED
  EXPORT_COMPLETED
}

enum CalendarEventType {
  TASK_DUE
  FOCUS_SESSION
  REVIEW_DEADLINE
  PROVIDER_EVENT
  PERSONAL
}

enum AIReportPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(cuid())
  name String?
  githubLogin String?
  email String? @unique
  emailVerified DateTime?
  image String?
  accounts Account[]
  sessions Session[]
  settings UserSettings?
  providerConnections ProviderConnection[]
  workspaces Workspace[]
  repositories Repository[]
  pullRequests PullRequest[]
  reviews Review[]
  issues Issue[]
  commits Commit[]
  pipelineRuns PipelineRun[]
  pipelineJobs PipelineJob[]
  activityEvents ActivityEvent[]
  tasks Task[]
  focusSessions FocusSession[]
  calendarEvents CalendarEvent[]
  notifications Notification[]
  syncStates SyncState[]
  syncJobs SyncJob[]
  aiReports AIReport[]
  exports ExportRecord[]
  webhookDeliveries WebhookDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([githubLogin])
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
  @@index([expires])
}

model UserSettings {
  id String @id @default(cuid())
  userId String @unique
  theme String @default("system")
  aiEnabled Boolean @default(false)
  excludePrivateFromAi Boolean @default(true)
  privateRepositories Boolean @default(true)
  smallPrThreshold Int @default(150)
  interruptionCostMinutes Int @default(20)
  timezone String @default("UTC")
  retentionDays Int @default(365)
  notifyReviews Boolean @default(true)
  notifyPipelines Boolean @default(true)
  notifyTasks Boolean @default(true)
  notifySyncFailures Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderConnection {
  id String @id @default(cuid())
  userId String
  provider Provider
  providerAccountId String
  displayName String
  status ConnectionStatus @default(PENDING)
  installationId String?
  encryptedCredential String?
  tokenExpiresAt DateTime?
  scopes String[]
  lastErrorCode String?
  lastErrorAt DateTime?
  disconnectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces Workspace[]
  repositories Repository[]
  pullRequests PullRequest[]
  issues Issue[]
  pipelineRuns PipelineRun[]
  syncStates SyncState[]
  syncJobs SyncJob[]
  webhookDeliveries WebhookDelivery[]
  @@unique([userId, provider, providerAccountId])
  @@index([userId, status])
}

model Workspace {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  provider Provider
  providerId String
  slug String
  name String
  avatarUrl String?
  kind String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  repositories Repository[]
  @@unique([userId, provider, providerId])
  @@index([userId, name])
}

model Repository {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  workspaceId String?
  provider Provider
  providerId String
  fullName String
  name String
  description String?
  url String
  defaultBranch String
  language String?
  isPrivate Boolean @default(false)
  isFork Boolean @default(false)
  isArchived Boolean @default(false)
  pushedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  pullRequests PullRequest[]
  issues Issue[]
  commits Commit[]
  pipelineRuns PipelineRun[]
  activityEvents ActivityEvent[]
  tasks Task[]
  focusSessions FocusSession[]
  calendarEvents CalendarEvent[]
  @@unique([userId, provider, providerId])
  @@index([userId, pushedAt])
  @@index([userId, fullName])
  @@index([workspaceId])
}

model PullRequest {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  repositoryId String
  providerId String
  number Int
  title String
  body String?
  url String
  state PullRequestState
  isDraft Boolean @default(false)
  authorLogin String
  headBranch String
  baseBranch String
  headSha String?
  additions Int @default(0)
  deletions Int @default(0)
  changedFiles Int @default(0)
  mergeable Boolean?
  mergeConflict Boolean?
  requestedReviewers String[]
  urgencyScore Int @default(0)
  urgencyReasons String[]
  providerCreatedAt DateTime
  providerUpdatedAt DateTime
  mergedAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews Review[]
  tasks Task[]
  @@unique([userId, repositoryId, providerId])
  @@unique([userId, repositoryId, number])
  @@index([userId, state, providerUpdatedAt])
  @@index([repositoryId, providerUpdatedAt])
}

model Review {
  id String @id @default(cuid())
  userId String
  pullRequestId String
  providerId String
  reviewerLogin String
  state ReviewState
  body String?
  requestedAt DateTime?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  @@unique([userId, pullRequestId, providerId])
  @@index([userId, state, submittedAt])
}

model Issue {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  repositoryId String
  providerId String
  number Int
  title String
  body String?
  url String
  state IssueState
  authorLogin String?
  assignees String[]
  labels String[]
  providerCreatedAt DateTime
  providerUpdatedAt DateTime
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tasks Task[]
  @@unique([userId, repositoryId, providerId])
  @@index([userId, state, providerUpdatedAt])
}

model Commit {
  id String @id @default(cuid())
  userId String
  repositoryId String
  providerId String
  sha String
  title String
  message String?
  url String
  authorLogin String?
  authorName String?
  committedAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@unique([userId, repositoryId, sha])
  @@index([userId, committedAt])
  @@index([repositoryId, committedAt])
}

model PipelineRun {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  repositoryId String
  providerId String
  name String
  url String
  status PipelineStatus
  conclusion String?
  branch String?
  commitSha String?
  triggeringActor String?
  startedAt DateTime?
  completedAt DateTime?
  durationSeconds Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  jobs PipelineJob[]
  @@unique([userId, repositoryId, providerId])
  @@index([userId, status, createdAt])
}

model PipelineJob {
  id String @id @default(cuid())
  userId String
  pipelineRunId String
  providerId String
  name String
  url String?
  status PipelineStatus
  conclusion String?
  startedAt DateTime?
  completedAt DateTime?
  durationSeconds Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  @@unique([userId, pipelineRunId, providerId])
  @@index([userId, status, createdAt])
}

model ActivityEvent {
  id String @id @default(cuid())
  userId String
  repositoryId String?
  provider Provider?
  providerEventId String
  type ActivityEventType
  title String
  description String?
  sourceUrl String?
  occurredAt DateTime
  metadata Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  @@unique([userId, providerEventId])
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([repositoryId, occurredAt])
}

model Task {
  id String @id @default(cuid())
  userId String
  repositoryId String?
  pullRequestId String?
  issueId String?
  title String
  description String?
  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueAt DateTime?
  tags String[]
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]
  @@index([userId, status, dueAt])
  @@index([userId, priority, createdAt])
}

model FocusSession {
  id String @id @default(cuid())
  userId String
  repositoryId String?
  taskId String?
  status FocusSessionStatus @default(RUNNING)
  plannedMinutes Int
  startedAt DateTime
  pausedAt DateTime?
  accumulatedPauseSeconds Int @default(0)
  completedAt DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([userId, startedAt])
  @@index([userId, status])
}

model CalendarEvent {
  id String @id @default(cuid())
  userId String
  repositoryId String?
  providerId String?
  type CalendarEventType
  title String
  description String?
  startsAt DateTime
  endsAt DateTime?
  allDay Boolean @default(false)
  sourceUrl String?
  timezone String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  @@unique([userId, providerId])
  @@index([userId, startsAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  body String
  href String?
  sourceKey String
  readAt DateTime?
  dismissedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceKey])
  @@index([userId, readAt, createdAt])
}

model SyncState {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  resource String
  cursor String?
  watermark DateTime?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastErrorCode String?
  consecutiveFailures Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  @@unique([userId, providerConnectionId, resource])
  @@index([userId, lastSuccessAt])
}

model SyncJob {
  id String @id @default(cuid())
  userId String
  providerConnectionId String
  correlationId String @unique
  status SyncJobStatus @default(QUEUED)
  attempt Int @default(0)
  maxAttempts Int @default(5)
  scheduledAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  nextRetryAt DateTime?
  progress Int @default(0)
  errorCode String?
  errorMessage String?
  stats Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model AIReport {
  id String @id @default(cuid())
  userId String
  period AIReportPeriod
  startsAt DateTime
  endsAt DateTime
  content Json
  source String
  model String?
  eventCount Int
  redactedCount Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@unique([userId, period, startsAt, endsAt])
}

model ExportRecord {
  id String @id @default(cuid())
  userId String
  destination String
  format String
  status ExportStatus @default(QUEUED)
  downloadKey String?
  errorCode String?
  completedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model WebhookDelivery {
  id String @id @default(cuid())
  userId String?
  providerConnectionId String?
  provider Provider
  deliveryId String
  eventName String
  signatureDigest String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  rejectedAt DateTime?
  status String
  errorCode String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  @@unique([provider, deliveryId])
  @@index([status, receivedAt])
  @@index([userId, receivedAt])
}
