# PostgreSQL
DATABASE_URL="postgresql://devdash:devdash@localhost:5432/devdash?schema=public"

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GitHub OAuth app used only for sign-in identity
GITHUB_ID=""
GITHUB_SECRET=""

# GitHub App used for repository access and webhooks
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Optional provider OAuth integrations
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_WEBHOOK_SECRET=""
BITBUCKET_CLIENT_ID=""
BITBUCKET_CLIENT_SECRET=""
BITBUCKET_WEBHOOK_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# 32-byte key encoded as base64. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""

# Optional AI brief generation
OPENAI_API_KEY=""

# Protects scheduled sync endpoints
CRON_SECRET=""
