# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devdash?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=""
GITHUB_SECRET=""

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: GitLab OAuth (https://gitlab.com/-/user_settings/applications)
GITLAB_ID=""
GITLAB_SECRET=""

# Optional: Bitbucket OAuth (https://bitbucket.org/account/settings/app-authorizations/)
BITBUCKET_ID=""
BITBUCKET_SECRET=""

# Optional: Google Calendar (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Slack (https://api.slack.com/apps)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Optional: CircleCI personal API token
CIRCLECI_TOKEN=""

# Cron secret for Render background sync
CRON_SECRET=""

# Local development only. Never enable in production.
USE_MOCK_DATA="false"
